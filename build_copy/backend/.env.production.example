# --- VOXFLOW BACKEND PRODUCTION CORE ---

# [CORE] SERVER CONFIG
PORT=5001
DEBUG=0
ENV=production

# [AUTH] SUPABASE & JWT
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PRODUCTION_SERVICE_ROLE_KEY
JWT_SECRET=PASTE_SAME_SECRET_AS_FRONTEND

# [INFRA] REDIS (Rate Limiting & Queue)
REDIS_URL=redis://your-production-redis:6379

# [AI PIPELINE]
ELEVEN_API_KEY=KEY1,KEY2,KEY3,KEY4,KEY5
WHISPER_MODEL=medium  # Upgrade to medium for production accuracy
RUNPOD_API_KEY=PRODUCTION_RUNPOD_KEY
RUNPOD_SERVERLESS=1

# [COMMUNICATION]
RESEND_API_KEY=PRODUCTION_RESEND_KEY
ADMIN_EMAIL=admin@voxflow.ai
