frontend/dist/
frontend/out/
frontend/build/
frontend/.env*
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Build Artifacts
build_copy/
dist/
*.exe
*.msi

# Media & Large Data
*.mp4
*.mp3
*.wav
*.zip
*.tar.gz
!backend/trending.json
!backend/templates.json

# IDE & OS
.vscode/
.idea/
.DS_Store
