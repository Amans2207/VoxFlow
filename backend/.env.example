# VOXFLOW NEURAL CORE - ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in the values

# --- API KEYS ---
# OpenAI (Neural Scripting & Refinement)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs (Neural Voice Synthesis)
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (Neural Vault)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SYSTEM SETTINGS ---
# Environment: 'development' or 'production'
IS_PROD=false

# Flask Port (Neural Gateway)
PORT=5001

# --- AI CONFIG ---
# Faster-Whisper Model: 'tiny', 'base', 'small', 'medium', 'large-v3'
WHISPER_MODEL=tiny
