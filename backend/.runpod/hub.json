{
  "title": "VoxFlow AI",
  "description": "High-fidelity AI video dubbing and localization engine.",
  "type": "serverless",
  "category": "video",
  "iconUrl": "https://voxflow.ai/icon.png",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 40,
    "presets": [
      {
        "name": "VoxFlow Standard",
        "defaults": {
          "WHISPER_MODEL": "base",
          "DEVICE": "cuda"
        }
      }
    ],
    "env": [
      {
        "key": "HF_TOKEN",
        "input": {
          "name": "HuggingFace Token",
          "type": "string",
          "description": "Token for accessing neural models",
          "required": true
        }
      },
      {
        "key": "WHISPER_MODEL",
        "input": {
          "name": "Whisper Model Size",
          "type": "string",
          "description": "Model size (tiny, base, small, medium, large-v3)",
          "default": "base"
        }
      }
    ]
  }
}
